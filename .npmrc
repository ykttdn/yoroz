# Never run lifecycle scripts (preinstall/install/postinstall) of dependencies
ignore-scripts=true

# Only resolve versions published more than 7 days ago
# (malicious releases from a hijacked package are usually caught and removed within hours to days)
min-release-age=7

# Record exact versions in package.json on `npm install <pkg>`, without a caret
save-exact=true

# Turn a Node/npm version that does not satisfy `engines` into an error, not a warning
engine-strict=true
