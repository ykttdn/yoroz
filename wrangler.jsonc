{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "yoroz",
  "main": "./worker/index.ts",
  // The newest date the bundled workerd (1.20260903.1) supports; a later date fails to start
  "compatibility_date": "2026-09-10",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Listed here so `wrangler types` can type them even where no .dev.vars exists (CI)
  "secrets": {
    "required": ["GOOGLE_CLIENT_ID", "GOOGLE_CLIENT_SECRET", "AUTH_SECRET", "ALLOWED_EMAILS"]
  }
}
