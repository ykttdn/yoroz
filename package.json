{
  "name": "yoroz",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "26.8.2",
    "npm": "12.0.2"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run cf-typegen && vue-tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/oauth-providers": "0.9.0",
    "@hono/zod-validator": "0.9.1",
    "drizzle-orm": "0.45.3",
    "hono": "4.13.8",
    "vue": "3.5.43",
    "vue-router": "5.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.62.5",
    "@cloudflare/vitest-plugin": "1.3.6",
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "26.6.2",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/test-utils": "2.5.1",
    "@vue/tsconfig": "0.9.1",
    "drizzle-kit": "0.31.10",
    "eslint": "10.11.0",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-vue": "10.11.1",
    "happy-dom": "20.14.5",
    "jiti": "2.7.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.2",
    "vitest": "4.1.11",
    "vue-tsc": "3.3.11",
    "wrangler": "4.147.0"
  }
}
