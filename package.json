{
  "name": "yoroz",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "26.8.2",
    "npm": "12.0.2"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run cf-typegen && vue-tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:seed:local": "wrangler d1 execute DB --local --file worker/db/seed.sql",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/oauth-providers": "0.9.0",
    "@hono/zod-validator": "0.9.1",
    "@tanstack/vue-query": "5.104.5",
    "@vueuse/core": "15.0.0",
    "drizzle-orm": "0.45.3",
    "hono": "4.13.13",
    "vue": "3.5.43",
    "vue-router": "5.4.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.65.0",
    "@cloudflare/vitest-plugin": "1.4.7",
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "@vue/tsconfig": "0.9.1",
    "daisyui": "5.7.50",
    "drizzle-kit": "0.31.11",
    "eslint": "10.13.0",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-tailwindcss": "4.4.0",
    "eslint-plugin-vue": "10.11.1",
    "happy-dom": "21.0.4",
    "jiti": "2.7.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.13",
    "wrangler": "4.152.0"
  }
}
